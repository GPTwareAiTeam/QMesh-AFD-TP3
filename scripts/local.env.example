# Copy to scripts/local.env (gitignored) and edit for this host.
# The launcher and gx_worker source it as defaults only: exported variables win.
# Values below are examples; none are required on a checkout that passes the
# same variables explicitly.
: "${EXP:=/path/to/qmesh-afd-tp3}"
: "${AFD_NATIVE_DIR:=${EXP}/native}"
: "${AFD_BIN_DIR:=${AFD_NATIVE_DIR}/bin}"
# : "${EDGES:=${EXP}/scripts/restart_afd_edges.sh}"
: "${VLLM_SRC:=/opt/vllm-moet}"
: "${MODEL_DIR:=/models/dsv41/p7-model}"
# : "${MODEL_MOUNT:=/models}"
: "${IMAGE:=vllm-moet:dsv41-213d5fa}"
: "${AFD_CONFIG_FILE:=${EXP}/p7/afd_overlay/afd.local.json}"
: "${GX1_HOST:=gx1}"
: "${GX2_HOST:=gx2}"
# Edge helper and gx_worker:
# : "${AFD_EDGE_BIN:=${AFD_BIN_DIR}/qmesh_afd_edge.aarch64}"
# : "${GX1_DEV:=rocep1s0f0}"
# : "${GX2_DEV:=rocep1s0f0}"
# : "${GX1_GID:=3}"
# : "${GX2_GID:=3}"
# : "${GX_SHM:=/dev/shm/qafd}"
# : "${GX_LOG:=/w/serve40g.log}"
# : "${GX_LAYERS:=40}"
# : "${GX_ROWS:=4096}"
# : "${GX_A2:=/w/a2.json}"
